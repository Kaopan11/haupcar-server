# Copy this file to .env and fill in your own values.
# Do not commit .env.

# From Supabase: Project Settings -> Database -> Connection string (URI).
# If the password contains @, write it as %40.
DATABASE_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.[project-ref].supabase.co:5432/postgres

# Port for the Node server.
PORT=3000

# The React app URL that is allowed to call this API.
CORS_ORIGIN=http://localhost:5173
